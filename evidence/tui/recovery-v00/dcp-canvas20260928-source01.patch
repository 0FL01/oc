+        .await
+        .unwrap();
+    state.refresh_completed_page(&page);
+    state.apply_dcp_snapshot(app.dcp_snapshot(session.clone()).await.unwrap());
+    state.chrome.dcp.show_compression = true;
+    let preview = app
+        .dcp_summary_page(
+            session.clone(),
+            run.operation_id.clone(),
+            0,
+            0,
