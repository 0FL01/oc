+        .await
+        .unwrap();
+    assert!(
+        app.tool_ops_page(session.clone(), None, 1)
+            .await
+            .unwrap()
+            .rows
+            .is_empty()
+    );
+    app.change_conversation(session.clone(), ConversationAction::Redo)
+        .await
+        .unwrap();
+    assert_eq!(
+        app.tool_ops_page(session.clone(), None, 1)
+            .await
+            .unwrap()
+            .rows[0]
+            .dcp,
