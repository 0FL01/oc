@@ -0,0 +1,18 @@
+import { Plugin } from "@opencode/plugin/tui"
+import type { EventEmitter } from "node:events"
+
+const events: EventEmitter = process
+
+export default Plugin.define({
+  id: "fixture.awaited-shutdown",
+  async setup(context) {
+    context.lifecycle.onShutdown(async () => {
+      await new Promise<void>((resolve) => events.emit("fixture.shutdown.begin", context.lifecycle, resolve))
+      events.emit("fixture.shutdown.end")
+      await context.renderer.resume()
+      throw new Error("fixture shutdown failure")
+    })
+    await context.renderer.suspend()
+    events.emit("fixture.shutdown.ready")
+  },
+})
